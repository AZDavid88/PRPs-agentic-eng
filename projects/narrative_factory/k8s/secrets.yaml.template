# Secrets template for sensitive configuration
# CodeFarm T04 Production Optimization Implementation
#
# IMPORTANT: This is a template file. Replace all PLACEHOLDER values with actual secrets.
# Never commit actual secrets to version control.
# Use tools like Sealed Secrets, External Secrets Operator, or Vault for production.

apiVersion: v1
kind: Secret
metadata:
  name: narrative-factory-secrets
  labels:
    app: narrative-factory
    component: secrets
type: Opaque
stringData:
  # Application secret key for JWT signing and encryption
  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
  secret-key: "PLACEHOLDER_SECRET_KEY_REPLACE_WITH_ACTUAL_VALUE"
  
  # Redis connection URL with authentication
  redis-url: "redis://:PLACEHOLDER_REDIS_PASSWORD@redis:6379/0"
  
  # Jina AI API key for embeddings
  jina-api-key: "PLACEHOLDER_JINA_API_KEY_REPLACE_WITH_ACTUAL_VALUE"
  
  # Google Gemini API key for LLM operations
  gemini-api-key: "PLACEHOLDER_GEMINI_API_KEY_REPLACE_WITH_ACTUAL_VALUE"
  
  # Database credentials (if needed for future expansion)
  database-url: "postgresql://PLACEHOLDER_DB_USER:PLACEHOLDER_DB_PASSWORD@postgres:5432/narrative_factory"
  
  # Optional: External service API keys
  # openai-api-key: "PLACEHOLDER_OPENAI_API_KEY"
  # anthropic-api-key: "PLACEHOLDER_ANTHROPIC_API_KEY"

---
# Redis authentication secret
apiVersion: v1
kind: Secret
metadata:
  name: redis-auth
  labels:
    app: redis
    component: auth
type: Opaque
stringData:
  # Redis password for authentication
  redis-password: "PLACEHOLDER_REDIS_PASSWORD_REPLACE_WITH_ACTUAL_VALUE"

---
# TLS certificates for HTTPS (if using cert-manager)
apiVersion: v1
kind: Secret
metadata:
  name: narrative-factory-tls
  labels:
    app: narrative-factory
    component: tls
type: kubernetes.io/tls
data:
  # Base64 encoded certificate and key
  # These would typically be managed by cert-manager
  tls.crt: PLACEHOLDER_TLS_CERT_BASE64
  tls.key: PLACEHOLDER_TLS_KEY_BASE64

---
# Image pull secrets (if using private registry)
apiVersion: v1
kind: Secret
metadata:
  name: narrative-factory-registry
  labels:
    app: narrative-factory
    component: registry
type: kubernetes.io/dockerconfigjson
data:
  # Docker registry authentication
  # Generated with: kubectl create secret docker-registry ...
  .dockerconfigjson: PLACEHOLDER_DOCKER_CONFIG_JSON_BASE64

---
# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT:
#
# 1. Copy this template to secrets.yaml
# 2. Replace all PLACEHOLDER values with actual secrets
# 3. Apply the secrets: kubectl apply -f secrets.yaml
# 4. Delete the secrets.yaml file or store it securely
# 5. Consider using external secret management tools for production:
#    - Sealed Secrets: https://github.com/bitnami-labs/sealed-secrets
#    - External Secrets Operator: https://external-secrets.io/
#    - HashiCorp Vault: https://www.vaultproject.io/
#    - AWS Secrets Manager
#    - Azure Key Vault
#    - Google Secret Manager
#
# Example commands to generate secure values:
#
# # Generate secret key
# python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# # Generate random password
# openssl rand -base64 32
#
# # Create Redis auth secret directly
# kubectl create secret generic redis-auth \
#   --from-literal=redis-password=$(openssl rand -base64 32)
#
# # Create app secrets directly
# kubectl create secret generic narrative-factory-secrets \
#   --from-literal=secret-key=$(python -c "import secrets; print(secrets.token_urlsafe(32))") \
#   --from-literal=redis-url="redis://:$(openssl rand -base64 32)@redis:6379/0" \
#   --from-literal=jina-api-key="YOUR_JINA_API_KEY" \
#   --from-literal=gemini-api-key="YOUR_GEMINI_API_KEY"