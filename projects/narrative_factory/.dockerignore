# CodeFarm T04: Docker build optimization exclusions

# Development files
.git
.gitignore
README.md
docs/
*.md

# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Test files and coverage
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Logs and temporary files
*.log
logs/
outputs/
temp/
tmp/

# Docker files (avoid recursive copying)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml

# Local configuration
.env.local
config/local/
secrets/

# Development scripts
scripts/dev/
validate_*.sh
dev_setup.sh

# Large data files
memory_bootstrap/
test_data/
*.db
*.sqlite3

# Node modules (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*